# Заполните адрес совместимого API (включая /v1, если требуется провайдером).
LLM_BASE_URL=
# Ключ не коммитить; пустое значение вызывает понятную ошибку конфигурации.
LLM_API_KEY=
# Имя модели из вашего провайдера.
LLM_MODEL=
LLM_TIMEOUT=60
# Модель для семантического поиска; первое использование загружает веса.
EMBED_MODEL=BAAI/bge-m3
RETRIEVE_MIN_SCORE=0.35

# bge-m3 — семантический поиск; lexical — быстрый запуск без весов.
EMBED_BACKEND=bge-m3
